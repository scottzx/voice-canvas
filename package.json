{
  "name": "@1agents/voice-canvas",
  "version": "0.1.0",
  "description": "Local Excalidraw canvas with a command-line interface",
  "license": "MIT",
  "type": "module",
  "engines": {"node": ">=22.14.0"},
  "bin": {"voice-canvas": "src/cli/canvas.mjs"},
  "files": ["dist", "src/cli", "src/server", "LICENSE", "README.md"],
  "repository": {"type": "git", "url": "git+https://github.com/scottzx/voice-canvas.git"},
